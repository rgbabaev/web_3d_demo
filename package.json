{
  "name": "scene",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Photorealistic living room with a computer work desk, rendered in the browser with three.js",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "shot": "node tools/screenshot.mjs"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "playwright": "1.62.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
